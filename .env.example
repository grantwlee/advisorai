# Flask environment
FLASK_ENV=development
PORT=5001
FLASK_DEBUG=1

# Database connection
# Use the Docker service name when running through compose.
DATABASE_URL=postgresql://admin:pass@db:5432/advisorai_db

# Local LLM configuration
LLM_BASE_URL=http://llm:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=180
LLM_CONTEXT_WINDOW=4096
LLM_PROMPT_CHUNK_CHAR_LIMIT=600
LLM_PROMPT_TOTAL_CHARS=2400
LLM_STARTUP_TIMEOUT_SECONDS=600
LLM_STARTUP_POLL_SECONDS=5

# Retrieval and logging
RETRIEVAL_DATA_DIR=/data/bulletins/processed
QUERY_LOG_PATH=/backend/logs/query_logs.jsonl

# Optional feature flags
USE_DEGREE_AUDIT_RULES=false

# Application secret(s)
SECRET_KEY=replace_me
